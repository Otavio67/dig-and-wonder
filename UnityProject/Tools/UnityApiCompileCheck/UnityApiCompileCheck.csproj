<Project Sdk="Microsoft.NET.Sdk">
  <!-- Checagem C# contra DLLs reais; não importa assets nem valida o grafo UPM. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <UnityRoot Condition="'$(UnityRoot)' == ''">$(MSBuildThisFileDirectory)../../../.tools/unity/6000.0.23f1</UnityRoot>
    <TemplateAssemblies Condition="'$(TemplateAssemblies)' == ''">$(UnityRoot)/Editor/Data/Resources/PackageManager/ProjectTemplates/libcache/com.unity.template.2d-cross-platform-5.0.2/ScriptAssemblies</TemplateAssemblies>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Assets/_Game/Scripts/**/*.cs" />
    <Compile Include="../../Assets/_Game/Editor/**/*.cs" />
    <Compile Include="../../Assets/_Game/ThirdParty/DOTween/Modules/DOTweenModuleSprite.cs" />
    <Reference Include="$(UnityRoot)/Editor/Data/Managed/UnityEngine/*.dll" />
    <Reference Include="$(UnityRoot)/Editor/Data/Managed/Newtonsoft.Json.dll" />
    <Reference Include="$(TemplateAssemblies)/Unity.InputSystem.dll" />
    <Reference Include="$(TemplateAssemblies)/Unity.TextMeshPro.dll" />
    <Reference Include="$(TemplateAssemblies)/UnityEngine.UI.dll" />
    <Reference Include="../../Assets/_Game/ThirdParty/DOTween/DOTween.dll" />
  </ItemGroup>
  <Target Name="RequireUnityLibraries" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(UnityRoot)/Editor/Unity') And !Exists('$(UnityRoot)/Editor/Unity.exe')" Text="Informe -p:UnityRoot=/caminho/do/editor instalado." />
    <Error Condition="!Exists('$(TemplateAssemblies)/Unity.InputSystem.dll')" Text="Esta checagem requer as DLLs do template 2D incluídas na imagem GameCI fixada pelo instalador." />
  </Target>
</Project>
