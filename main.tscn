[gd_scene format=3]

[node name="DigAndWonder" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
color = Color(0.035, 0.055, 0.09, 1)

[node name="Center" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="TitleGroup" type="VBoxContainer" parent="Center"]
layout_mode = 2
theme_override_constants/separation = 24

[node name="Eyebrow" type="Label" parent="Center/TitleGroup"]
layout_mode = 2
theme_override_colors/font_color = Color(0.38, 0.86, 0.79, 1)
theme_override_font_sizes/font_size = 14
text = "CAVE. TRANSFORME. DESCUBRA."
horizontal_alignment = 1

[node name="Title" type="Label" parent="Center/TitleGroup"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.79, 0.34, 1)
theme_override_font_sizes/font_size = 64
text = "DIG &\nWONDER"
horizontal_alignment = 1

[node name="Tagline" type="Label" parent="Center/TitleGroup"]
layout_mode = 2
theme_override_colors/font_color = Color(0.75, 0.8, 0.89, 1)
theme_override_font_sizes/font_size = 19
text = "O próximo mundo está logo abaixo."
horizontal_alignment = 1
